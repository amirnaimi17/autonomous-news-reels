# Copy to .env and fill in secrets. Never commit .env.

APP_ENV=development
CLIENT_ID=default
CLIENT_NAME=Default
TIMEZONE=Europe/Berlin
DAILY_REEL_LIMIT=3
PRODUCTION_SLOTS=09:00,14:00,19:00
CATCH_UP_MISSED_SLOTS=true

# Only stories published inside this window are eligible.
NEWS_WINDOW_HOURS=72
MIN_IMPORTANCE_SCORE=0.55

# Fail closed: an uncertain semantic match is treated as a duplicate.
FAIL_CLOSED_DEDUPLICATION=true
TITLE_JACCARD_DUPLICATE_THRESHOLD=0.72
SUMMARY_JACCARD_DUPLICATE_THRESHOLD=0.40
ENTITY_JACCARD_DUPLICATE_THRESHOLD=0.50
SIMHASH_HAMMING_THRESHOLD=8

# rss reads NEWS_SOURCES or NEWS_SOURCES_FILE. There is no built-in feed list.
# static returns only articles supplied by the caller and is for tests.
NEWS_PROVIDER=rss
# JSON list of objects with name, url, and language. Empty selects nothing.
# NEWS_SOURCES=[{"name":"Example","url":"https://example.com/feed.xml","language":"en"}]
NEWS_SOURCES=
# Optional file. When set, it replaces NEWS_SOURCES. See config/news_sources.example.json.
NEWS_SOURCES_FILE=
STOPWORDS_DIR=config/stopwords
# Optional. See config/entity_aliases.example.json. Missing file means no aliases.
ENTITY_ALIASES_FILE=
# none is the only provider. Cross-language paraphrase matching stays off.
TRANSLATION_PROVIDER=none
# Stories older than yesterday, still inside the 72-hour window, need this score.
OLDER_WINDOW_MIN_IMPORTANCE=0.75
HTTP_TIMEOUT_SECONDS=20
HTTP_USER_AGENT=AutonomousNewsReels/0.1

DATABASE_PATH=data/news_reels.db
OUTPUT_DIR=storage
LOG_LEVEL=INFO
LOG_FILE=

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_ENCODER=auto
FFMPEG_BIN=ffmpeg
MIN_REEL_SECONDS=8
MAX_REEL_SECONDS=90

# Working offline providers. Replace these when credentials are chosen.
IMAGE_PROVIDER=solid
TTS_PROVIDER=silent
NOTIFICATION_PROVIDER=log
LLM_PROVIDER=extractive

# Telegram is the first real notifier and is wired in Phase 6.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional language-model provider for Phase 3 Persian scripts.
# LLM_PROVIDER=extractive remains the offline English slide fallback.
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-4o-mini

# ElevenLabs speech (Aran). Leave empty unless running an explicit approved voice test.
ELEVENLABS_API_KEY=

# Reel runtime (generate-reel). Cron and Instagram publishing stay off by default.
REEL_SCRIPT_PROVIDER=off
# REEL_SCRIPT_OUTPUT_DIR=storage/generated/reels/scripts
REEL_PAID_GENERATION=false
REEL_ELEVENLABS_APPROVED=false
# REEL_AUDIO_OUTPUT_DIR=storage/generated/reels/audio
# REEL_GENERATION_HOURS=7,11,15,19
# REEL_TARGET_PAGE=almanyar
# REEL_VOICE_ID=PEdcOLzbXYhL8IKOswXB

# Keep false until a publisher exists. true is rejected at startup.
INSTAGRAM_PUBLISH_ENABLED=false

SLOT_STALE_SECONDS=2700
LOCK_TTL_SECONDS=900
MAX_GENERATION_ATTEMPTS=3
